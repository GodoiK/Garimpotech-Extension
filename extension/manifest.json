{
  "manifest_version": 3,
  "name": "GarimpoTech — Comparador de preços tech",
  "short_name": "GarimpoTech",
  "version": "1.0.0",
  "description": "Compare preços de produtos tech (GPU, CPU, SSD, RAM) no Mercado Livre e na Amazon, novos e usados, com histórico de preços.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.mercadolivre.com.br/*",
    "https://*.amazon.com.br/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GarimpoTech — comparar preços",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://produto.mercadolivre.com.br/*",
        "https://www.mercadolivre.com.br/*",
        "https://www.amazon.com.br/*"
      ],
      "js": [
        "stores.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}